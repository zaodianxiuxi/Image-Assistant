# Create a SudoCode API key at https://sudocode.chat/keys and paste it here.
SUDOCODE_API_KEY=sk-your-key-here

# Optional: use the documented backup endpoint when the default is unavailable.
# SUDOCODE_BASE_URL=https://api.sudorelay.com/v1

# Optional: text model used by “生成新灵感”、故事分镜和风格提示词组合.
# SUDOCODE_TEXT_MODEL=gpt-5.6-sol

# Optional: vision-capable chat model used to analyze one reference image.
# When SUDOCODE_TEXT_MODEL is empty, this model also composes the final prompt.
# SUDOCODE_VISION_MODEL=gpt-5.4-mini

# Optional: enable local MySQL metadata and prompt management.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=image_assistant
# MYSQL_CONNECTION_LIMIT=5
